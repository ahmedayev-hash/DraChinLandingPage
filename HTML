<script>

/* =====================================================
   CONFIG
===================================================== */

const API_KEY =
  "REDACTED_TMDB_API_KEY";

const BASE_URL =
  "https://api.themoviedb.org/3";

const IMG_URL =
  "https://image.tmdb.org/t/p/w500";


/*
  Klik sponsor akan bergantian:

  Klik sponsor #1 = CPM
  Klik sponsor #2 = Shopee
  Klik sponsor #3 = CPM
  dst.
*/

const CPM_URL =
  "https://www.profitableratecpmnetwork.com/gf1teu3z?key=6c1f06f266d4061bbd5f98e2e447766a";

const SHOPEE_URL =
  "https://s.shopee.co.id/9peLe2gVIP?share_channel_code=1";


/* =====================================================
   ELEMENTS
===================================================== */

const movieGrid =
  document.getElementById("movieGrid");

const player =
  document.getElementById("player");

const loadArea =
  document.getElementById("loadArea");

const loadMore =
  document.getElementById("loadMore");

const searchInput =
  document.getElementById("searchInput");

const sectionTitle =
  document.getElementById("sectionTitle");

const resultInfo =
  document.getElementById("resultInfo");

const toast =
  document.getElementById("toast");


/* =====================================================
   STATE
===================================================== */

let currentPage = 1;

let totalPages = 1;

let currentMode =
  "popular";

let currentSearch =
  "";

let searchTimer =
  null;

let loading =
  false;

let sponsorIndex =
  0;


/*
  Menyimpan status klik per film.

  false / belum ada =
  klik berikutnya sponsor.

  true =
  sponsor sudah diklik,
  klik berikutnya trailer.
*/

const movieClickState = {};


/* =====================================================
   ESCAPE
===================================================== */

function escapeHTML(value){

  return String(value ?? "")
  .replace(
    /[&<>"']/g,
    function(c){

      const map = {

        "&":"&amp;",

        "<":"&lt;",

        ">":"&gt;",

        '"':"&quot;",

        "'":"&#039;"

      };

      return map[c];

    }
  );

}


/* =====================================================
   TOAST
===================================================== */

let toastTimer = null;

function showToast(message){

  clearTimeout(
    toastTimer
  );

  toast.textContent =
    message;

  toast.classList.add(
    "show"
  );

  toastTimer =
    setTimeout(
      function(){

        toast.classList.remove(
          "show"
        );

      },
      2600
    );

}


/* =====================================================
   OPEN SPONSOR
===================================================== */

function openSponsor(){

  const links = [

    CPM_URL,

    SHOPEE_URL

  ];


  const url =
    links[
      sponsorIndex %
      links.length
    ];


  sponsorIndex++;


  window.open(
    url,
    "_blank",
    "noopener,noreferrer"
  );

}


/* =====================================================
   TWO-STEP CLICK
===================================================== */

function handleMovieClick(id){

  /*
    KLIK PERTAMA
    = SPONSOR
  */

  if(!movieClickState[id]){

    movieClickState[id] =
      true;

    openSponsor();

    showToast(
      "Sponsor dibuka • klik sekali lagi untuk memutar trailer"
    );

    return;

  }


  /*
    KLIK KEDUA
    = TRAILER
  */

  movieClickState[id] =
    false;

  showMovieDetails(id);

}


/* =====================================================
   LOADING
===================================================== */

function showLoading(){

  movieGrid.innerHTML = `

    <div class="loading">

      <div class="spinner"></div>

      Memuat drama China...

    </div>

  `;

}


/* =====================================================
   POPULAR URL
===================================================== */

function popularURL(page){

  const params =
    new URLSearchParams({

      api_key:
        API_KEY,

      language:
        "id-ID",

      with_origin_country:
        "CN",

      with_original_language:
        "zh",

      sort_by:
        "popularity.desc",

      include_adult:
        "false",

      include_null_first_air_dates:
        "false",

      "vote_count.gte":
        "5",

      page:
        String(page)

    });


  return (

    BASE_URL +

    "/discover/tv?" +

    params.toString()

  );

}


/* =====================================================
   FETCH MOVIES
===================================================== */

async function fetchMovies(
  page = 1,
  append = false
){

  if(loading){
    return;
  }


  loading = true;


  if(!append){

    showLoading();

  }


  try{


    const response =
      await fetch(
        popularURL(page)
      );


    if(!response.ok){

      throw new Error(
        "HTTP " +
        response.status
      );

    }


    const data =
      await response.json();


    totalPages =
      Number(
        data.total_pages ||
        1
      );


    displayMovies(
      data.results || [],
      append
    );


    sectionTitle.textContent =
      "Dracin Populer";


    resultInfo.textContent =
      "Halaman " +
      page;


    loadArea.style.display =

      page < totalPages

      ? "block"

      : "none";


  }catch(error){


    console.error(error);


    if(!append){

      movieGrid.innerHTML = `

        <div class="error">

          Drama gagal dimuat.

          <br><br>

          <button
            class="load-more"
            onclick="location.reload()"
          >
            COBA LAGI
          </button>

        </div>

      `;

    }


    resultInfo.textContent =
      "Gagal memuat";


  }finally{

    loading = false;

  }

}


/* =====================================================
   DISPLAY MOVIES
===================================================== */

function displayMovies(
  movies,
  append = false
){

  let html = "";


  movies.forEach(
    function(movie){


      const id =
        Number(movie.id);


      const title =

        movie.name ||

        movie.original_name ||

        "Tanpa Judul";


      const safeTitle =
        escapeHTML(title);


      const poster =

        movie.poster_path

        ? IMG_URL +
          movie.poster_path

        : "";


      const year =

        movie.first_air_date

        ? String(
            movie.first_air_date
          ).substring(
            0,
            4
          )

        : "-";


      const rating =

        typeof movie.vote_average ===
        "number"

        ? movie.vote_average
            .toFixed(1)

        : "-";


      html += `

        <article class="movie-card">


          <div
            class="poster"
            onclick="handleMovieClick(${id})"
          >


            ${
              poster

              ? `

                <img
                  src="${escapeHTML(poster)}"
                  alt="${safeTitle}"
                  loading="lazy"
                >

              `

              : `

                <div style="
                  width:100%;
                  height:100%;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  padding:15px;
                  color:#777;
                  text-align:center;
                  font-size:11px;
                ">

                  ${safeTitle}

                </div>

              `
            }


            <span class="rating">

              <span class="rating-star">
                ★
              </span>

              ${escapeHTML(rating)}

            </span>


            <span class="country">
              CN
            </span>


            <span class="play-icon">
              ▶
            </span>


            <span class="click-notice">

              KLIK 1 SPONSOR · KLIK 2 TRAILER

            </span>


          </div>


          <div
            class="movie-title"
            title="${safeTitle}"
          >

            ${safeTitle}

          </div>


          <div class="movie-meta">

            ${escapeHTML(year)}
            · Drama China

          </div>


          <div class="movie-action">

            <button
              class="btn-watch"
              type="button"
              onclick="handleMovieClick(${id})"
            >

              ▶ BUKA TRAILER

            </button>

          </div>


        </article>

      `;

    }
  );


  if(append){

    movieGrid.insertAdjacentHTML(
      "beforeend",
      html
    );

  }else{

    movieGrid.innerHTML =

      html ||

      `

        <div class="error">

          Drama tidak ditemukan.

        </div>

      `;

  }

}


/* =====================================================
   LOAD MORE
===================================================== */

loadMore.addEventListener(
  "click",
  function(){


    if(loading){
      return;
    }


    if(
      currentPage >=
      totalPages
    ){
      return;
    }


    currentPage++;


    if(
      currentMode ===
      "popular"
    ){

      fetchMovies(
        currentPage,
        true
      );

    }else{

      searchMovies(
        currentSearch,
        currentPage,
        true
      );

    }

  }
);


/* =====================================================
   SEARCH
===================================================== */

searchInput.addEventListener(
  "input",
  function(){


    const query =
      this.value.trim();


    clearTimeout(
      searchTimer
    );


    searchTimer =
      setTimeout(
        function(){


          if(query === ""){


            currentMode =
              "popular";


            currentPage =
              1;


            currentSearch =
              "";


            fetchMovies(
              1,
              false
            );


            return;

          }


          if(
            query.length >=
            2
          ){


            currentMode =
              "search";


            currentPage =
              1;


            currentSearch =
              query;


            searchMovies(
              query,
              1,
              false
            );

          }


        },
        350
      );

  }
);


/* =====================================================
   SEARCH API
===================================================== */

async function searchMovies(
  query,
  page = 1,
  append = false
){

  if(loading){
    return;
  }


  loading = true;


  if(!append){

    showLoading();

  }


  try{


    const params =
      new URLSearchParams({

        api_key:
          API_KEY,

        language:
          "id-ID",

        query:
          query,

        include_adult:
          "false",

        page:
          String(page)

      });


    const response =
      await fetch(

        BASE_URL +

        "/search/tv?" +

        params.toString()

      );


    if(!response.ok){

      throw new Error(
        "Search gagal"
      );

    }


    const data =
      await response.json();


    const chineseDrama =

      (data.results || [])

      .filter(
        function(item){


          const countries =
            item.origin_country ||
            [];


          return (

            countries.includes(
              "CN"
            )

            ||

            item.original_language ===
            "zh"

          );

        }
      );


    totalPages =
      Number(
        data.total_pages ||
        1
      );


    displayMovies(
      chineseDrama,
      append
    );


    sectionTitle.textContent =
      'Hasil: "' +
      query +
      '"';


    resultInfo.textContent =
      "Halaman " +
      page;


    loadArea.style.display =

      page < totalPages

      ? "block"

      : "none";


  }catch(error){


    console.error(error);


    if(!append){

      movieGrid.innerHTML = `

        <div class="error">

          Pencarian gagal.

        </div>

      `;

    }


  }finally{

    loading = false;

  }

}


/* =====================================================
   DETAIL
===================================================== */

async function getDetails(id){

  const params =
    new URLSearchParams({

      api_key:
        API_KEY,

      language:
        "id-ID"

    });


  const response =
    await fetch(

      BASE_URL +

      "/tv/" +

      encodeURIComponent(id) +

      "?" +

      params.toString()

    );


  if(!response.ok){

    throw new Error(
      "Detail gagal"
    );

  }


  return response.json();

}


/* =====================================================
   TRAILER
===================================================== */

async function getTrailer(id){

  try{


    const params =
      new URLSearchParams({

        api_key:
          API_KEY

      });


    const response =
      await fetch(

        BASE_URL +

        "/tv/" +

        encodeURIComponent(id) +

        "/videos?" +

        params.toString()

      );


    if(!response.ok){

      return null;

    }


    const data =
      await response.json();


    const videos =
      data.results ||
      [];


    let trailer =

      videos.find(
        function(video){

          return (

            video.site ===
            "YouTube"

            &&

            video.type ===
            "Trailer"

            &&

            video.official ===
            true

          );

        }
      );


    if(!trailer){

      trailer =

        videos.find(
          function(video){

            return (

              video.site ===
              "YouTube"

              &&

              video.type ===
              "Trailer"

            );

          }
        );

    }


    if(!trailer){

      trailer =

        videos.find(
          function(video){

            return (

              video.site ===
              "YouTube"

            );

          }
        );

    }


    return trailer

      ? trailer.key

      : null;


  }catch(error){


    console.error(error);


    return null;

  }

}


/* =====================================================
   SHOW MOVIE
===================================================== */

async function showMovieDetails(id){


  player.innerHTML = `

    <section class="player-box">

      <div class="loading">

        <div class="spinner"></div>

        Memuat trailer...

      </div>

    </section>

  `;


  player.scrollIntoView({

    behavior:
      "smooth",

    block:
      "start"

  });


  try{


    const results =
      await Promise.all([

        getDetails(id),

        getTrailer(id)

      ]);


    const movie =
      results[0];


    const trailer =
      results[1];


    const title =

      movie.name ||

      movie.original_name ||

      "Drama China";


    const description =

      movie.overview ||

      "Deskripsi belum tersedia.";


    const date =

      movie.first_air_date ||

      "-";


    const rating =

      typeof movie.vote_average ===
      "number"

      ? movie.vote_average
          .toFixed(1)

      : "-";


    const seasons =
      movie.number_of_seasons ||
      "-";


    const episodes =
      movie.number_of_episodes ||
      "-";


    let videoHTML;


    if(trailer){


      videoHTML = `

        <div class="video">

          <iframe

            src="https://www.youtube.com/embed/${encodeURIComponent(trailer)}"

            title="Trailer ${escapeHTML(title)}"

            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"

            allowfullscreen

          ></iframe>

        </div>

      `;


    }else{


      videoHTML = `

        <div class="no-video">

          🎬

          <br><br>

          Trailer belum tersedia.

        </div>

      `;

    }


    player.innerHTML = `

      <section class="player-box">


        <div class="player-header">


          <h2>

            ${escapeHTML(title)}

          </h2>


          <button

            class="close-btn"

            type="button"

            onclick="closePlayer()"

          >

            ✕

          </button>


        </div>


        ${videoHTML}


        <div class="detail">


          <p class="description">

            ${escapeHTML(description)}

          </p>


          <div class="detail-meta">


            <span>

              📅
              ${escapeHTML(date)}

            </span>


            <span>

              ⭐
              ${escapeHTML(rating)}

            </span>


            <span>

              📺
              ${escapeHTML(seasons)}
              Season

            </span>


            <span>

              🎞
              ${escapeHTML(episodes)}
              Episode

            </span>


          </div>


        </div>


      </section>

    `;


  }catch(error){


    console.error(error);


    player.innerHTML = `

      <section class="player-box">

        <div class="no-video">

          Gagal memuat drama.

        </div>

      </section>

    `;

  }

}


